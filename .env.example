# Database Configuration
# Choose your database client: sqlite3, pg, mysql2
DB_CLIENT=sqlite3

# For SQLite3 (default)
DB_FILENAME=./dev.sqlite3

# For PostgreSQL
# DB_CLIENT=pg
# DB_CONNECTION=postgresql://username:password@localhost:5432/database_name
# Or individual connection parameters:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=username
# DB_PASSWORD=password
# DB_DATABASE=database_name

# For MySQL
# DB_CLIENT=mysql2
# DB_CONNECTION=mysql://username:password@localhost:3306/database_name
# Or individual connection parameters:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=username
# DB_PASSWORD=password
# DB_DATABASE=database_name

# Connection pool settings (for PostgreSQL/MySQL)
DB_POOL_MIN=2
DB_POOL_MAX=10

# Migration settings
DB_MIGRATIONS_DIR=./migrations
DB_MIGRATIONS_TABLE=knex_migrations

# Seed settings
DB_SEEDS_DIR=./seeds

# Next-Auth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# Root User Credentials for login
ROOT_USER=admin@example.com
ROOT_PASSWORD=change-this-password

# OAuth Provider Credentials (uncomment when needed)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
