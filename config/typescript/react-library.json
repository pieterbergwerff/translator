{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "React Library",
    "extends": "./base.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "@packages/components/*": [
                "../../../packages/components/src/*"
            ],
            "@packages/hooks/*": [
                "../../../packages/hooks/src/*"
            ],
            "@packages/validators/*": [
                "../../../packages/validators/src/*"
            ],
            "@packages/types/*": [
                "../../../packages/types/src/*"
            ],
            "@packages/constants/*": [
                "../../../packages/constants/src/*"
            ],
            "@packages/theme/*": [
                "../../../packages/theme/src/*"
            ],
            "@packages/translate/*": [
                "../../../packages/translate/src/*"
            ],
            "@utils/common/*": [
                "../../../utils/common/src/*"
            ],
            "@utils/server/*": [
                "../../../utils/server/src/*"
            ],
            "@utils/client/*": [
                "../../../utils/client/src/*"
            ]
        }
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
