{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@packages/components/*": ["./packages/components/src/*"],
      "@packages/hooks/*": ["./packages/hooks/src/*"],
      "@packages/validators/*": ["./packages/validators/src/*"],
      "@packages/types/*": ["./packages/types/src/*"],
      "@packages/constants/*": ["./packages/constants/src/*"],
      "@packages/theme/*": ["./packages/theme/src/*"],
      "@packages/translate/*": ["./packages/translate/src/*"],
      "@utils/common/*": ["./utils/common/src/*"],
      "@utils/server/*": ["./utils/server/src/*"],
      "@utils/client/*": ["./utils/client/src/*"],
      "@config/typescript": ["./config/typescript"],
      "@config/eslint": ["./config/eslint"],
      "@config/prettier": ["./config/prettier"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
