        "@config/typescript": "*",
        "@testing-library/jest-dom": "^6.0.0",
        "@testing-library/react": "^15.0.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.3.0",
        "@vitest/ui": "^1.6.0",
        "eslint": "^9.0.0",
