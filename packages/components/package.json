        "@radix-ui/react-toggle-group": "^1.1.11",
        "@radix-ui/react-visually-hidden": "^1.2.4",
        "@utils/server": "*",
        "@utils/client": "*",
        "class-variance-authority": "^0.7.0",
        "lucide-react": "^0.468.0",
        "next-auth": "^4.24.0"
    },
    "devDependencies": {
        "@config/eslint": "*",
        "@config/typescript": "*",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "autoprefixer": "^10.4.19",
        "eslint": "^9.0.0",
        "postcss": "^8.4.38",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "tailwindcss": "^3.4.0",
        "tailwindcss-animate": "^1.0.7",
