{
    "name": "@packages/components",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./atoms/*": "./src/atoms/*/index.tsx",
        "./molecules/*": "./src/molecules/*/index.tsx",
        "./organisms/*": "./src/organisms/*/index.tsx",
        "./pages/*": "./src/pages/*/index.tsx",
        "./providers/*": "./src/providers/*/index.tsx",
        "./templates/*": "./src/templates/*/index.tsx"
    },
    "typesVersions": {
        "*": {
            "atoms/*": [
                "./src/atoms/*/index.tsx"
            ],
            "molecules/*": [
                "./src/molecules/*/index.tsx"
            ],
            "organisms/*": [
                "./src/organisms/*/index.tsx"
            ],
            "pages/*": [
                "./src/pages/*/index.tsx"
            ],
            "providers/*": [
                "./src/providers/*/index.tsx"
            ],
            "templates/*": [
                "./src/templates/*/index.tsx"
            ]
        }
    },
    "scripts": {
        "clean": "rm -rf dist node_modules package-lock.json .turbo",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "ui:add": "npx shadcn@latest add"
    },
    "dependencies": {
        "@radix-ui/react-slot": "^1.0.2",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.0",
        "lucide-react": "^0.390.0",
        "tailwind-merge": "^2.4.0"
    },
    "devDependencies": {
        "@config/eslint": "*",
        "@config/typescript": "*",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "autoprefixer": "^10.4.19",
        "eslint": "^9.0.0",
        "postcss": "^8.4.38",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "tailwindcss": "^3.4.0",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.5.0"
    },
    "peerDependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    }
