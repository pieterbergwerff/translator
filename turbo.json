{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env*"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**",
                "build/**",
                "storybook-static/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "**/*.test.*"
            ]
        },
        "test:ui": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".eslintrc.js",
                ".eslintignore"
            ]
        },
        "storybook": {
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "tsconfig.json"
            ]
        },
        "@apps/test-ui#build": {
            "outputs": []
        },
        "@packages/database#build": {
            "outputs": []
        }
    }
}
